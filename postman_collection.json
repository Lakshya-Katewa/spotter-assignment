{
  "info": {
    "name": "Fuel Route Planner",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Plan route (GET) - New York to Los Angeles",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      }
    },
    {
      "name": "Plan route (GET) - without geometry",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Chicago, IL&finish=Dallas, TX&geometry=false",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Dallas, TX"
            },
            {
              "key": "geometry",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "Plan route (GET) - street address start",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=1600 Pennsylvania Ave NW, Washington, DC&finish=Boston, MA&geometry=false",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "1600 Pennsylvania Ave NW, Washington, DC"
            },
            {
              "key": "finish",
              "value": "Boston, MA"
            },
            {
              "key": "geometry",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "Plan route (GET) - full tank at start",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Chicago, IL&finish=Dallas, TX&start_fuel_gallons=50&geometry=false",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Dallas, TX"
            },
            {
              "key": "start_fuel_gallons",
              "value": "50"
            },
            {
              "key": "geometry",
              "value": "false"
            }
          ]
        },
        "description": "start_fuel_gallons=50: the truck leaves with a full tank, which isn't charged; total_fuel_cost covers only fuel bought on the way."
      }
    },
    {
      "name": "Plan route (GET) - strictly cheapest plan",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Chicago, IL&finish=Dallas, TX&min_stop_savings=0&geometry=false",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Dallas, TX"
            },
            {
              "key": "min_stop_savings",
              "value": "0"
            },
            {
              "key": "geometry",
              "value": "false"
            }
          ]
        },
        "description": "min_stop_savings=0: the strictly cheapest plan (more, smaller stops). fewer_stops_alternative shows the default $5 plan next to it."
      }
    },
    {
      "name": "Plan route (POST) - coordinates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"47.6062,-122.3321\",\n  \"finish\": \"Miami, FL\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        }
      }
    },
    {
      "name": "Error - outside USA",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=Toronto, ON&finish=Dallas, TX",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Toronto, ON"
            },
            {
              "key": "finish",
              "value": "Dallas, TX"
            }
          ]
        }
      }
    },
    {
      "name": "No price data on route - 422 with route (SF to LA)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=San Francisco, CA&finish=Los Angeles, CA&geometry=false",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "San Francisco, CA"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            },
            {
              "key": "geometry",
              "value": "false"
            }
          ]
        },
        "description": "The price file has no station along this route: 422 with code no_stations_on_route, but the route, start, finish and map_url are still returned. Add start_fuel_gallons=50 to get a plan with no stops."
      }
    },
    {
      "name": "Map page (open in browser)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/map/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "map",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      }
    },
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/healthz",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "healthz"
          ]
        },
        "description": "200 when the station data is loaded; 503 otherwise. No upstream calls."
      }
    }
  ]
}
