DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Routing: public OSRM demo server (no key). Point at your own OSRM for production use.
OSRM_URL=https://router.project-osrm.org
# Only used for free-form addresses; "City, ST" and "lat,lon" are resolved locally.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
EXTERNAL_TIMEOUT=20
GEOCODE_CACHE_SECONDS=2592000
GEOCODE_MAX_WAIT_SECONDS=5
ROUTING_MAX_WAIT_SECONDS=5
API_THROTTLE_RATE=60/min

VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
STATION_CORRIDOR_MILES=15
STATION_NEAR_ROUTE_MILES=2
START_APPROACH_MILES=30
# Skip a fuel stop when it saves less than this many dollars (0 = strictly cheapest plan).
MIN_STOP_SAVINGS=0
ROUTE_CACHE_SECONDS=86400

# Optional: share caches, request coalescing and the geocoder rate limit across workers.
# REDIS_URL=redis://localhost:6379/0

# For any real deployment: DJANGO_DEBUG=0 and a real DJANGO_SECRET_KEY.
